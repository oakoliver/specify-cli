{
  "name": "@oakoliver/specify-cli",
  "version": "1.0.3",
  "description": "Spec-Driven Development CLI for AI coding agents. Multi-runtime.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "specify": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "templates"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "esbuild src/index.ts src/cli.ts --bundle --format=esm --outdir=dist --platform=node --external:@oakoliver/*",
    "build:cjs": "esbuild src/index.ts --bundle --format=cjs --outfile=dist/index.cjs --platform=node --external:@oakoliver/*",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "spec-driven-development",
    "sdd",
    "cli",
    "ai",
    "copilot",
    "claude",
    "gemini",
    "opencode",
    "specification",
    "tui",
    "terminal"
  ],
  "author": "Antonio Oliveira <antonio@oakoliver.com> (https://oakoliver.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oakoliver/specify-cli.git"
  },
  "homepage": "https://github.com/oakoliver/specify-cli#readme",
  "bugs": {
    "url": "https://github.com/oakoliver/specify-cli/issues"
  },
  "devDependencies": {
    "@oakoliver/bubbletea": "^1.0.0",
    "@oakoliver/bubbles": "^1.0.0",
    "@oakoliver/glamour": "^1.0.0",
    "@types/bun": "^1.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@oakoliver/huh": "^1.0.0",
    "@oakoliver/lipgloss": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
